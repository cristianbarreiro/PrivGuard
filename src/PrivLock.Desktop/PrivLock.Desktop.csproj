<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(OS)' == 'Windows_NT'">net10.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(OS)' != 'Windows_NT'">net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PrivLock.Desktop</RootNamespace>
    <AssemblyName>PrivGvard</AssemblyName>
    <Product>PrivGvard</Product>
    <Title>PrivGvard</Title>
    <Description>PrivGvard - Camera &amp; Microphone Privacy Guard</Description>
    <Company>cdev Studio</Company>
    <Copyright>© 2026 cdev Studio. All rights reserved.</Copyright>
    <ApplicationManifest Condition="$([MSBuild]::IsOSPlatform('Windows'))">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="$([MSBuild]::IsOSPlatform('Windows'))">Assets\app.ico</ApplicationIcon>
    <!-- Keep Avalonia's runtime content available to the explicitly registered Win32 backend
         when running as a .NET single-file application. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.2.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Serilog" Version="3.1.1" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PrivLock.Domain\PrivLock.Domain.csproj" />
    <ProjectReference Include="..\PrivLock.Platform.Abstractions\PrivLock.Platform.Abstractions.csproj" />
    <ProjectReference Include="..\PrivLock.Infrastructure.Common\PrivLock.Infrastructure.Common.csproj" />
    <ProjectReference Include="..\PrivLock.Application\PrivLock.Application.csproj" />
    <ProjectReference Include="..\PrivLock.UI\PrivLock.UI.csproj" />
    <ProjectReference Include="..\PrivLock.Platform.Windows\PrivLock.Platform.Windows.csproj" />
    <ProjectReference Include="..\PrivLock.Platform.Linux\PrivLock.Platform.Linux.csproj" />
    <ProjectReference Include="..\PrivLock.Platform.MacOS\PrivLock.Platform.MacOS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PrivLock.Platform.Windows.Tests" />
  </ItemGroup>

</Project>
